# All settings are optional; defaults let the pipeline run with `--dry-run`.

# Postgres in production; defaults to a local SQLite file.
# XSWARM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/xswarm

# Needed for anything other than --dry-run. Set either provider; OpenAI wins when both
# are present unless XSWARM_LLM_PROVIDER is set explicitly to "anthropic".
# XSWARM_OPENAI_API_KEY=
# XSWARM_ANTHROPIC_API_KEY=
# XSWARM_LLM_PROVIDER=auto

# Optional, raise rate limits / unlock enrichment.
# XSWARM_SEMANTIC_SCHOLAR_API_KEY=
# XSWARM_GITHUB_TOKEN=
# XSWARM_HF_TOKEN=
